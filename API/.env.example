# Copie para .env (cp .env.example .env). O .env NÃO vai para o GitHub.
PORT=3000
NODE_ENV=development
# Sites autorizados a chamar a API (separados por vírgula). Em produção no Render,
# o site e a API ficam na mesma URL, então pode ficar vazio.
CORS_ORIGIN=http://127.0.0.1:5500,http://localhost:5500
# Caminho do arquivo SQLite (relativo à pasta API)
ARQUIVO_BANCO=dados/agrotax.db
# Senha para consultar os leads (GET /api/leads). Use um valor longo e aleatório.
# Se ficar vazio, a rota de leads fica desativada.
TOKEN_ADMIN=
